<% const pageTitle = 'Browse Members' %>
<%- include('partials/header') %>

<div class="box">
  <div class="box-title">Browse Members</div>
  <div class="box-body">
    <form method="get" action="/browse" class="search-form">
      <input type="text" name="q" value="<%= q %>" placeholder="Search by name, location, or interest..." style="width:60%">
      <button class="btn btn-primary btn-sm">Search</button>
      <% if (q) { %><a href="/browse" class="small">Clear</a><% } %>
    </form>

    <% if (users.length === 0) { %>
      <p class="muted">No members found.</p>
    <% } else { %>
      <div class="member-grid">
        <% users.forEach(function(u) { %>
          <a href="/profile/<%= u.id %>" class="member-card">
            <img src="<%= u.photo_url || '/img/default-avatar.svg' %>">
            <div class="member-name"><%= u.full_name %></div>
            <div class="muted small">
              <% if (u.age) { %><%= u.age %><% } %>
              <% if (u.age && u.location) { %> &middot; <% } %>
              <% if (u.location) { %><%= u.location %><% } %>
            </div>
            <% if (u.tagline) { %><div class="member-tagline">"<%= u.tagline %>"</div><% } %>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
